# Copie este arquivo para .env (cp .env.example .env) e ajuste se precisar.

# Endereço de conexão do PostgreSQL usado pelo Prisma.
# Este valor bate com o banco do docker-compose (docker compose up db).
DATABASE_URL="postgresql://arremata:arremata@localhost:5432/arremata"

# Porta em que a API escuta. O front (vite.config.ts) faz proxy para a 3333.
PORT=3333

# Endereço do front que pode chamar a API (CORS). Em produção, a URL da Vercel.
CORS_ORIGIN="http://localhost:5173"

# Segredo para assinar os tokens de login (JWT).
# Obrigatório em produção; em desenvolvimento há um valor padrão.
JWT_SECRET="troque-por-um-texto-longo-e-aleatorio"

# Segredo do HMAC da cadeia de hashes dos lances (auditoria).
# Obrigatório em produção. Se mudar depois que houver lances, a auditoria
# vai acusar adulteração, porque os hashes antigos foram feitos com o segredo anterior.
CHAIN_SECRET="troque-por-outro-texto-longo-e-aleatorio"
