# Variáveis do docker-compose.yml. Copie para .env (cp .env.example .env).
# Todas têm um valor padrão no compose, então o .env é opcional para rodar localmente.

# Usuário, senha e nome do banco criado no container do Postgres
POSTGRES_USER=arremata
POSTGRES_PASSWORD=arremata
POSTGRES_DB=arremata

# Porta do Postgres no seu computador (troque se a 5432 já estiver em uso)
DB_PORT=5432

# Segredos da API (veja backend/.env.example). Troque por textos longos e aleatórios.
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio
CHAIN_SECRET=troque-por-outro-texto-longo-e-aleatorio
